{
  "name": "drumnext",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config projection/vite.config.ts",
    "build": "tsc -b && vite build --config projection/vite.config.ts",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint projection/src projection/tests projection/vite.config.ts",
    "test": "vitest run --config projection/vitest.config.ts",
    "test:e2e": "playwright test --config projection/playwright.config.ts"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "pixi.js": "^8.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.1.0",
    "eslint": "^9.32.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  }
}
